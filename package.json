{
  "name": "campingil",
  "private": true,
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "app": "npm run start --workspace app",
    "server": "npm run dev --workspace server",
    "typecheck": "npm run typecheck --workspace app && npm run typecheck --workspace server",
    "scrape": "node scripts/scrapeCampsites.js",
    "scrape:fast": "node scripts/scrapeCampsites.js --no-coords",
    "scrape:merge": "node scripts/scrapeCampsites.js --merge"
  },
  "devDependencies": {
    "cheerio": "^1.0.0",
    "puppeteer": "^23.0.0"
  }
}
