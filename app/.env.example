# Base URL of the CampingIL backend API (see ../server).
# expo-router / Expo picks up any env var prefixed with EXPO_PUBLIC_ at build time.
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Supabase project used for user accounts and each user's saved favorites
# (Project Settings -> API in the Supabase dashboard). Use the "anon public"
# key: it is safe in the app because Row Level Security protects the data.
# NEVER put the service_role key here. Leave both empty to build the app
# without accounts (the log-in button is then hidden).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Travel agent (the Vercel function in api/, run locally with
# `npm run agent:dev` from the repo root).
# Anthropic API key, from console.anthropic.com -> API Keys. SERVER-ONLY:
# it must never get the EXPO_PUBLIC_ prefix, which would publish it inside
# the app. On Vercel, add it as ANTHROPIC_API_KEY in the project settings.
ANTHROPIC_API_KEY=
# Where the app sends agent requests during local development. Leave unset
# in production: the website calls its own /api/agent/chat.
# EXPO_PUBLIC_AGENT_API_URL=http://localhost:8787
